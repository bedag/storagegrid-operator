              "k8s_cluster_name": true,
              "metrics_path": true,
              "Value": true
            },
            "renameByName": {
              "phase": "Phase",
              "bucket_name": "Bucket name"
            },
            "indexByName": {
              "cluster": 0,
              "namespace": 1,
              "s3bucket": 2
            }
          }
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "id": 6
    },
    {
      "type": "table",
      "title": "S3Accesses",
      "description": "Phase and bucket of each S3Access.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max without (pod, instance) (storagegrid_operator_s3access_status_phase{cluster=~\"$cluster\",namespace=~\"$namespace\"} == 1) * on (cluster, namespace, s3access) group_left (s3bucket) max without (pod, instance) (storagegrid_operator_s3access_info{cluster=~\"$cluster\",namespace=~\"$namespace\"})",
          "refId": "A",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
