      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max without (pod, instance) (storagegrid_operator_s3bucket_status_phase{cluster=~\"$cluster\",namespace=~\"$namespace\"} == 1) * on (cluster, namespace, s3bucket) group_left (s3tenant, bucket_name, region) max without (pod, instance) (storagegrid_operator_s3bucket_info{cluster=~\"$cluster\",namespace=~\"$namespace\"})",
          "refId": "A",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
