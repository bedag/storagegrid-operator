{
  "title": "StorageGrid Operator / Overview",
  "uid": "storagegrid-operator-overview",
  "description": "Admin overview of the storagegrid-operator across clusters: CR health, tenant usage and quota, grid endpoints and StorageGrid API calls.",
  "tags": [
    "storagegrid",
    "s3"
  ],
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "timezone": "browser",
  "annotations": {
    "list": []
  },
  "links": [],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "regex": "",
        "current": {},
        "hide": 0,
        "refresh": 1
      },
      {
        "name": "cluster",
        "label": "Cluster",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(storagegrid_operator_storagegrid_info, cluster)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery",
          "qryType": 1
        },
        "definition": "label_values(storagegrid_operator_storagegrid_info, cluster)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {},
        "sort": 1,
        "hide": 0
      },
      {
        "name": "storagegrid",
        "label": "StorageGrid",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(storagegrid_operator_storagegrid_info{cluster=~\"$cluster\"}, storagegrid)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery",
          "qryType": 1
        },
        "definition": "label_values(storagegrid_operator_storagegrid_info{cluster=~\"$cluster\"}, storagegrid)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {},
        "sort": 1,
        "hide": 0
      },
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(storagegrid_operator_s3tenant_info{cluster=~\"$cluster\"}, namespace)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery",
          "qryType": 1
        },
        "definition": "label_values(storagegrid_operator_s3tenant_info{cluster=~\"$cluster\"}, namespace)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {},
        "sort": 1,
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "id": 1,
      "title": "Overview",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "StorageGrid readiness",
      "description": "status.ready of each StorageGrid CR.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "min by (cluster, storagegrid) (storagegrid_operator_storagegrid_ready{cluster=~\"$cluster\",storagegrid=~\"$storagegrid\"})",
          "refId": "A",
          "legendFormat": "{{cluster}} / {{storagegrid}}",
          "range": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Not ready",
                  "color": "red"
                },
                "1": {
                  "text": "Ready",
                  "color": "green"
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "id": 2
    },
    {
      "type": "stat",
      "title": "Grid scrape health",
      "description": "Whether each step of the live grid scrape (/metrics/grid) succeeded.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "min by (cluster, storagegrid, step) (storagegrid_operator_grid_scrape_success{cluster=~\"$cluster\",storagegrid=~\"$storagegrid\"})",
          "refId": "A",
          "legendFormat": "{{cluster}} / {{storagegrid}} / {{step}}",
          "range": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Failing",
                  "color": "red"
                },
                "1": {
                  "text": "OK",
                  "color": "green"
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "id": 3
    },
    {
      "type": "stat",
      "title": "Resources not ready",
      "description": "Custom resources of all kinds whose Ready condition is not True.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count(max without (pod, instance) (label_replace({__name__=~\"storagegrid_operator_.+_status_condition\",type=\"Ready\",status!=\"True\",cluster=~\"$cluster\"}, \"kind\", \"$1\", \"__name__\", \"storagegrid_operator_(.+)_status_condition\") == 1)) or vector(0)",
          "refId": "A",
          "legendFormat": "not ready",
          "range": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "id": 4
    },
    {
      "type": "stat",
      "title": "Tenants above 85% quota",
      "description": "Tenant accounts using more than 85% of their quota.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count((max without (pod, instance) (storagegrid_operator_s3tenantaccount_usage_bytes{cluster=~\"$cluster\",storagegrid=~\"$storagegrid\"}) / max without (pod, instance) (storagegrid_operator_s3tenantaccount_quota_bytes{cluster=~\"$cluster\",storagegrid=~\"$storagegrid\"})) > 0.85) or vector(0)",
          "refId": "A",
          "legendFormat": "tenants",
          "range": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "id": 5
    },
    {
      "type": "stat",
      "title": "Earliest endpoint cert expiry",
      "description": "Days until the first S3TenantClass endpoint certificate expires.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "min((storagegrid_operator_s3tenantclass_endpoint_cert_expiry_timestamp_seconds{cluster=~\"$cluster\",storagegrid=~\"$storagegrid\"} - time()) / 86400)",
          "refId": "A",
          "legendFormat": "days",
          "range": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 14
              },
              {
                "color": "green",
                "value": 30
              }
            ]
          },
          "unit": "d"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "id": 6
    },
    {
      "type": "row",
      "id": 7,
      "title": "Tenants",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "panels": []
    },
    {
      "type": "table",
      "title": "Tenant usage",
      "description": "Live usage of every bound S3Tenant, from the grid.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max without (pod, instance) (storagegrid_operator_s3tenant_usage_bytes{cluster=~\"$cluster\",storagegrid=~\"$storagegrid\",namespace=~\"$namespace\"})",
          "refId": "A",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max without (pod, instance) (storagegrid_operator_s3tenant_quota_bytes{cluster=~\"$cluster\",storagegrid=~\"$storagegrid\",namespace=~\"$namespace\"})",
          "refId": "B",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max without (pod, instance) (storagegrid_operator_s3tenant_usage_bytes{cluster=~\"$cluster\",storagegrid=~\"$storagegrid\",namespace=~\"$namespace\"}) / max without (pod, instance) (storagegrid_operator_s3tenant_quota_bytes{cluster=~\"$cluster\",storagegrid=~\"$storagegrid\",namespace=~\"$namespace\"})",
          "refId": "C",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max without (pod, instance) (storagegrid_operator_s3tenant_usage_objects{cluster=~\"$cluster\",storagegrid=~\"$storagegrid\",namespace=~\"$namespace\"})",
          "refId": "D",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Used"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Quota"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Quota used"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "max",
                "value": 1
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "basic"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 0.85
                    },
                    {
                      "color": "red",
                      "value": 0.95
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Quota used",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "endpoint": true,
              "instance": true,
              "job": true,
              "pod": true,
              "service": true,
              "k8s_cluster_name": true,
              "metrics_path": true
            },
            "renameByName": {
              "Value #A": "Used",
              "Value #B": "Quota",
              "Value #C": "Quota used",
              "Value #D": "Objects",
              "s3tenantaccount": "S3TenantAccount",
              "tenant_id": "Tenant ID"
            },
            "indexByName": {
              "cluster": 0,
              "storagegrid": 1,
              "namespace": 2,
              "s3tenant": 3,
              "s3tenantaccount": 4,
              "tenant_id": 5,
              "Value #A": 6,
              "Value #B": 7,
              "Value #C": 8,
              "Value #D": 9
            }
          }
        }
      ],
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 7
      },
      "id": 8
    },
    {
      "type": "timeseries",
      "title": "Top 10 tenants by usage",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "topk(10, max without (pod, instance) (storagegrid_operator_s3tenant_usage_bytes{cluster=~\"$cluster\",storagegrid=~\"$storagegrid\",namespace=~\"$namespace\"}))",
          "refId": "A",
          "legendFormat": "{{cluster}} / {{namespace}}/{{s3tenant}}",
          "range": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "id": 9
    },
    {
      "type": "timeseries",
      "title": "Used vs. quota per grid",
      "description": "All tenant accounts of each grid, bound or not.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (cluster, storagegrid) (max without (pod, instance) (storagegrid_operator_s3tenantaccount_usage_bytes{cluster=~\"$cluster\",storagegrid=~\"$storagegrid\"}))",
          "refId": "A",
          "legendFormat": "used {{cluster}} / {{storagegrid}}",
          "range": true,
          "format": "time_series"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (cluster, storagegrid) (max without (pod, instance) (storagegrid_operator_s3tenantaccount_quota_bytes{cluster=~\"$cluster\",storagegrid=~\"$storagegrid\"}))",
          "refId": "B",
          "legendFormat": "quota {{cluster}} / {{storagegrid}}",
          "range": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "id": 10
    },
    {
      "type": "row",
      "id": 11,
      "title": "Buckets",
      "collapsed": true,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "panels": [
        {
          "type": "table",
          "title": "Bucket usage (spec.metrics.bucketUsage)",
          "description": "Only populated for grids with spec.metrics.bucketUsage enabled.",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "targets": [
            {
              "datasource": {
                "type": "prometheus",
                "uid": "${datasource}"
              },
              "expr": "max without (pod, instance) (storagegrid_operator_s3bucket_usage_bytes{cluster=~\"$cluster\",namespace=~\"$namespace\"})",
              "refId": "A",
              "legendFormat": "__auto",
              "instant": true,
              "range": false,
              "format": "table"
            },
            {
              "datasource": {
                "type": "prometheus",
                "uid": "${datasource}"
              },
              "expr": "max without (pod, instance) (storagegrid_operator_s3bucket_usage_objects{cluster=~\"$cluster\",namespace=~\"$namespace\"})",
              "refId": "B",
              "legendFormat": "__auto",
              "instant": true,
              "range": false,
              "format": "table"
            }
          ],
          "fieldConfig": {
            "defaults": {},
            "overrides": [
              {
                "matcher": {
                  "id": "byName",
                  "options": "Used"
                },
                "properties": [
                  {
                    "id": "unit",
                    "value": "bytes"
                  }
                ]
              }
            ]
          },
          "options": {
            "showHeader": true,
            "cellHeight": "sm",
            "sortBy": [
              {
                "displayName": "Used",
                "desc": true
              }
            ]
          },
          "transformations": [
            {
              "id": "merge",
              "options": {}
            },
            {
              "id": "organize",
              "options": {
                "excludeByName": {
                  "Time": true,
                  "__name__": true,
                  "endpoint": true,
                  "instance": true,
                  "job": true,
                  "pod": true,
                  "service": true,
                  "k8s_cluster_name": true,
                  "metrics_path": true
                },
                "renameByName": {
                  "Value #A": "Used",
                  "Value #B": "Objects"
                }
              }
            }
          ],
          "gridPos": {
            "h": 9,
            "w": 24,
            "x": 0,
            "y": 25
          },
          "id": 12
        }
      ]
    },
    {
      "type": "row",
      "id": 13,
      "title": "Resources",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 25
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Resources by phase",
      "description": "Number of resources per phase, per kind.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count by (phase) (max without (pod, instance) (storagegrid_operator_s3tenantaccount_status_phase{cluster=~\"$cluster\"} == 1))",
          "refId": "A",
          "legendFormat": "S3TenantAccount {{phase}}",
          "range": true,
          "format": "time_series"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count by (phase) (max without (pod, instance) (storagegrid_operator_s3tenant_status_phase{cluster=~\"$cluster\"} == 1))",
          "refId": "B",
          "legendFormat": "S3Tenant {{phase}}",
          "range": true,
          "format": "time_series"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count by (phase) (max without (pod, instance) (storagegrid_operator_s3bucket_status_phase{cluster=~\"$cluster\"} == 1))",
          "refId": "C",
          "legendFormat": "S3Bucket {{phase}}",
          "range": true,
          "format": "time_series"
        },
        {
