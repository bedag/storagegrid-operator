        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count by (phase) (max without (pod, instance) (storagegrid_operator_s3access_status_phase{cluster=~\"$cluster\",namespace=~\"$namespace\"} == 1))",
          "refId": "C",
          "legendFormat": "S3Access {{phase}}",
          "range": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
