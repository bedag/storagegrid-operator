{
  "title": "S3 Storage / Usage",
  "uid": "storagegrid-s3-usage",
  "description": "Storage used by the S3Tenants and S3Buckets in your namespaces, as reported live by the StorageGrid.",
  "tags": [
    "storagegrid",
    "s3"
  ],
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "timezone": "browser",
  "annotations": {
    "list": []
  },
  "links": [],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "regex": "",
        "current": {},
        "hide": 0,
        "refresh": 1
      },
      {
        "name": "cluster",
        "label": "Cluster",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(storagegrid_operator_s3tenant_info, cluster)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery",
          "qryType": 1
        },
        "definition": "label_values(storagegrid_operator_s3tenant_info, cluster)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {},
        "sort": 1,
        "hide": 0
      },
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(storagegrid_operator_s3tenant_info{cluster=~\"$cluster\"}, namespace)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery",
          "qryType": 1
        },
        "definition": "label_values(storagegrid_operator_s3tenant_info{cluster=~\"$cluster\"}, namespace)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {},
        "sort": 1,
        "hide": 0
      },
      {
        "name": "s3tenant",
        "label": "S3Tenant",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(storagegrid_operator_s3tenant_info{cluster=~\"$cluster\",namespace=~\"$namespace\"}, s3tenant)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery",
          "qryType": 1
        },
        "definition": "label_values(storagegrid_operator_s3tenant_info{cluster=~\"$cluster\",namespace=~\"$namespace\"}, s3tenant)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {},
        "sort": 1,
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "id": 1,
      "title": "Tenants",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "bargauge",
      "title": "Quota used",
      "description": "Share of each S3Tenant's quota in use.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max without (pod, instance) (storagegrid_operator_s3tenant_usage_bytes{cluster=~\"$cluster\",namespace=~\"$namespace\",s3tenant=~\"$s3tenant\"}) / max without (pod, instance) (storagegrid_operator_s3tenant_quota_bytes{cluster=~\"$cluster\",namespace=~\"$namespace\",s3tenant=~\"$s3tenant\"})",
          "refId": "A",
          "legendFormat": "{{namespace}}/{{s3tenant}}",
          "range": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.85
              },
              {
                "color": "red",
                "value": 0.95
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "id": 2
    },
    {
      "type": "table",
      "title": "Tenant overview",
      "description": "Live usage reported by the StorageGrid.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max without (pod, instance) (storagegrid_operator_s3tenant_usage_bytes{cluster=~\"$cluster\",namespace=~\"$namespace\",s3tenant=~\"$s3tenant\"})",
          "refId": "A",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max without (pod, instance) (storagegrid_operator_s3tenant_quota_bytes{cluster=~\"$cluster\",namespace=~\"$namespace\",s3tenant=~\"$s3tenant\"})",
          "refId": "B",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max without (pod, instance) (storagegrid_operator_s3tenant_usage_objects{cluster=~\"$cluster\",namespace=~\"$namespace\",s3tenant=~\"$s3tenant\"})",
          "refId": "C",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Used"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Quota"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "endpoint": true,
              "instance": true,
              "job": true,
              "pod": true,
              "service": true,
              "k8s_cluster_name": true,
              "metrics_path": true,
              "storagegrid": true,
              "s3tenantaccount": true,
              "tenant_id": true
            },
            "renameByName": {
              "Value #A": "Used",
              "Value #B": "Quota",
              "Value #C": "Objects"
            },
            "indexByName": {
              "cluster": 0,
              "namespace": 1,
              "s3tenant": 2,
              "Value #A": 3,
              "Value #B": 4,
              "Value #C": 5
            }
          }
        }
      ],
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "id": 3
    },
    {
      "type": "timeseries",
      "title": "Used storage",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max without (pod, instance) (storagegrid_operator_s3tenant_usage_bytes{cluster=~\"$cluster\",namespace=~\"$namespace\",s3tenant=~\"$s3tenant\"})",
          "refId": "A",
          "legendFormat": "used {{namespace}}/{{s3tenant}}",
          "range": true,
          "format": "time_series"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max without (pod, instance) (storagegrid_operator_s3tenant_quota_bytes{cluster=~\"$cluster\",namespace=~\"$namespace\",s3tenant=~\"$s3tenant\"})",
          "refId": "B",
          "legendFormat": "quota {{namespace}}/{{s3tenant}}",
          "range": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "quota .*"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "Objects",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max without (pod, instance) (storagegrid_operator_s3tenant_usage_objects{cluster=~\"$cluster\",namespace=~\"$namespace\",s3tenant=~\"$s3tenant\"})",
          "refId": "A",
          "legendFormat": "{{namespace}}/{{s3tenant}}",
          "range": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "id": 5
    },
    {
      "type": "row",
      "id": 6,
      "title": "Buckets",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "panels": []
    },
    {
      "type": "table",
      "title": "Bucket usage",
      "description": "Per-bucket usage. Empty unless your platform team enabled bucket metrics for the grid.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max without (pod, instance) (storagegrid_operator_s3bucket_usage_bytes{cluster=~\"$cluster\",namespace=~\"$namespace\",s3tenant=~\"$s3tenant\"})",
          "refId": "A",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max without (pod, instance) (storagegrid_operator_s3bucket_usage_objects{cluster=~\"$cluster\",namespace=~\"$namespace\",s3tenant=~\"$s3tenant\"})",
          "refId": "B",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Used"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Used",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "endpoint": true,
              "instance": true,
              "job": true,
              "pod": true,
              "service": true,
              "k8s_cluster_name": true,
              "metrics_path": true
            },
            "renameByName": {
              "Value #A": "Used",
              "Value #B": "Objects",
              "bucket_name": "Bucket name"
            },
            "indexByName": {
              "cluster": 0,
              "namespace": 1,
              "s3tenant": 2,
              "s3bucket": 3,
              "bucket_name": 4,
              "Value #A": 5,
              "Value #B": 6
            }
          }
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 17
      },
      "id": 7
    },
    {
      "type": "timeseries",
      "title": "Bucket size",
      "description": "The 10 largest buckets.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "topk(10, max without (pod, instance) (storagegrid_operator_s3bucket_usage_bytes{cluster=~\"$cluster\",namespace=~\"$namespace\",s3tenant=~\"$s3tenant\"}))",
          "refId": "A",
          "legendFormat": "{{namespace}}/{{s3bucket}}",
          "range": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 17
      },
      "id": 8
    }
  ]
}
